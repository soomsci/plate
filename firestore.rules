rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function sessionPath(code) {
      return /databases/$(database)/documents/sessions/$(code);
    }

    function sessionExists(code) {
      return exists(sessionPath(code));
    }

    function isTeacher(code) {
      return signedIn()
        && sessionExists(code)
        && get(sessionPath(code)).data.ownerUid == request.auth.uid;
    }

    function publicComparison(code) {
      return sessionExists(code)
        && get(sessionPath(code)).data.phase in ['compare', 'reveal', 'eastAsia', 'closed'];
    }

    function validParticipation(data) {
      return (data.get('participationMode', 'group') == 'group' && data.groupCount == 7)
        || (data.get('participationMode', 'group') == 'individual' && data.groupCount == 25);
    }

    match /sessions/{code} {
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && validParticipation(request.resource.data);
      allow read: if signedIn();
      allow update: if isTeacher(code)
        && validParticipation(request.resource.data)
        && request.resource.data.get('participationMode', 'group') == resource.data.get('participationMode', 'group')
        && request.resource.data.groupCount == resource.data.groupCount;
      allow delete: if isTeacher(code);

      match /groups/{groupId} {
        allow create: if signedIn()
          && sessionExists(code)
          && request.resource.data.group is int
          && groupId == string(request.resource.data.group)
          && request.resource.data.group >= 1
          && request.resource.data.group <= get(sessionPath(code)).data.groupCount
          && request.resource.data.ownerUid == request.auth.uid;
        allow read: if signedIn()
          && (resource.data.ownerUid == request.auth.uid
            || isTeacher(code)
            || publicComparison(code));
        allow update: if signedIn()
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.group == resource.data.group
          && (resource.data.ownerUid == request.auth.uid || isTeacher(code));
        allow delete: if isTeacher(code);
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
